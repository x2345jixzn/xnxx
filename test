// Dynamic Balance Manager Class for handling demo/live accounts
class DynamicBalanceManager {
  constructor() {
    this.refreshInterval = 100; // 0.1 seconds
    this.observer = null;
    this.intervalId = null;
    this.initializeObserver();
  }

  get elementsExist() {
    const desktopSelectors = [
      '.usermenu__accounts .usermenu__select-item--radio:last-child .usermenu__select-balance',
      '.usermenu__select-balance__edit-input input',
      '.usermenu__info-balance',
      '.usermenu__accounts .usermenu__select-item--radio:first-child .usermenu__select-balance',
      '.usermenu__select-item--radio:first-child',
      '.usermenu__select-item--radio.active'
    ];

    const mobileSelectors = [
      '.usermenu__accounts li.usermenu__select-item:nth-child(1) .usermenu__select-balance',
      '.usermenu__accounts li.usermenu__select-item:nth-child(2) .usermenu__select-balance',
      '.usermenu__select-balance__edit-input input',
      '.usermenu__info-balance',
      '.usermenu__accounts li.usermenu__select-item:nth-child(1)',
      '.usermenu__accounts li.usermenu__select-item:nth-child(2)'
    ];

    const desktopReady = desktopSelectors.every(sel => document.querySelector(sel));
    const mobileReady = mobileSelectors.every(sel => document.querySelector(sel));

    return desktopReady || mobileReady;
  }

  get elements() {
    const desktopElements = {
      demoBalance: document.querySelector('.usermenu__accounts .usermenu__select-item--radio:last-child .usermenu__select-balance'),
      demoBalanceInput: document.querySelector('.usermenu__select-balance__edit-input input'),
      infoBalance: document.querySelector('.usermenu__info-balance'),
      liveBalance: document.querySelector('.usermenu__accounts .usermenu__select-item--radio:first-child .usermenu__select-balance'),
      liveAccountItem: document.querySelector('.usermenu__select-item--radio:first-child'),
      demoAccountItem: document.querySelector('.usermenu__select-item--radio.active'),
    };

    const mobileElements = {
      liveBalance: document.querySelector('.usermenu__accounts li.usermenu__select-item:nth-child(1) .usermenu__select-balance'),
      demoBalance: document.querySelector('.usermenu__accounts li.usermenu__select-item:nth-child(2) .usermenu__select-balance'),
      demoBalanceInput: document.querySelector('.usermenu__select-balance__edit-input input'),
      infoBalance: document.querySelector('.usermenu__info-balance'),
      liveAccountItem: document.querySelector('.usermenu__accounts li.usermenu__select-item:nth-child(1)'),
      demoAccountItem: document.querySelector('.usermenu__accounts li.usermenu__select-item:nth-child(2)'),
    };

    const isDesktop = desktopElements.demoBalance && desktopElements.liveBalance;
    const isMobile = mobileElements.demoBalance && mobileElements.liveBalance;

    if (isDesktop) return desktopElements;
    if (isMobile) return mobileElements;
    return {};
  }

  setDemoBalance() {
    const { demoBalance } = this.elements;
    const balanceText = this.elements.infoBalance?.innerHTML;
    if (!balanceText) return;

    const currencyData = detectCurrency(balanceText);
    const demoBalanceValue = getDemoBalance(currencyConfig, currencyData.code);
    
    try {
      if (demoBalance) demoBalance.textContent = `${currencyData.symbol}${demoBalanceValue}`;
    } catch (error) {
      console.error('Error setting demo balance:', error);
    }
  }

  syncLiveAccountBalance() {
    const { infoBalance, liveBalance } = this.elements;
    try {
      if (infoBalance && liveBalance) {
        const currentBalance = infoBalance.textContent.trim();
        liveBalance.textContent = currentBalance;
      }
    } catch (error) {
      console.error('Error syncing live balance:', error);
    }
  }

  setLiveAccountActive() {
    const { liveAccountItem, demoAccountItem } = this.elements;
    try {
      if (liveAccountItem && demoAccountItem) {
        liveAccountItem.classList.add('active');
        demoAccountItem.classList.remove('active');

        const liveAccountLink = liveAccountItem.querySelector('a');
        const demoAccountLink = demoAccountItem.querySelector('a');

        if (liveAccountLink && demoAccountLink) {
          liveAccountLink.classList.add('active');
          demoAccountLink.classList.remove('active');
          liveAccountLink.setAttribute('aria-current', 'page');
          demoAccountLink.removeAttribute('aria-current');
        }
      }
    } catch (error) {
      console.error('Error setting active account:', error);
    }
  }

  start() {
    if (!this.elementsExist) return false;

    try {
      this.setDemoBalance();
      this.syncLiveAccountBalance();
      this.setLiveAccountActive();
      updateAccountLevel();

      this.intervalId = setInterval(() => {
        this.setDemoBalance();
        this.syncLiveAccountBalance();
        updateAccountLevel();
      }, this.refreshInterval);

      return true;
    } catch (error) {
      console.error('Start error:', error);
      return false;
    }
  }

  stop() {
    if (this.intervalId) {
      clearInterval(this.intervalId);
      this.intervalId = null;
    }
  }

  initializeObserver() {
    const observerConfig = { childList: true, subtree: true, attributes: false, characterData: false };

    this.observer = new MutationObserver(() => {
      if (this.elementsExist) {
        if (!this.intervalId) this.start();
      } else {
        this.stop();
      }
    });

    this.observer.observe(document.body, observerConfig);
  }

  destroy() {
    this.stop();
    if (this.observer) {
      this.observer.disconnect();
      this.observer = null;
    }
  }
}

